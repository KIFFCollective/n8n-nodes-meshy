{
	"name": "Meshy: run task with stock polling loop (sub-workflow)",
	"nodes": [
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--0",
			"name": "When Called",
			"type": "n8n-nodes-base.executeWorkflowTrigger",
			"typeVersion": 1.1,
			"position": [
				0,
				0
			],
			"parameters": {
				"workflowInputs": {
					"values": [
						{
							"name": "taskType"
						},
						{
							"name": "body",
							"type": "object"
						},
						{
							"name": "format"
						}
					]
				}
			}
		},
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--1",
			"name": "Create Task",
			"type": "n8n-nodes-meshy.meshy",
			"typeVersion": 1,
			"position": [
				240,
				0
			],
			"parameters": {
				"resource": "task",
				"taskType": "={{ $json.taskType }}",
				"operation": "create",
				"requestBody": "={{ JSON.stringify($json.body) }}"
			},
			"credentials": {
				"meshyApi": {
					"id": "REPLACE_ME",
					"name": "Meshy account"
				}
			}
		},
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--2",
			"name": "Get Task",
			"type": "n8n-nodes-meshy.meshy",
			"typeVersion": 1,
			"position": [
				480,
				0
			],
			"parameters": {
				"resource": "task",
				"taskType": "={{ $('When Called').item.json.taskType }}",
				"operation": "get",
				"taskId": "={{ $('Create Task').item.json.id }}"
			},
			"credentials": {
				"meshyApi": {
					"id": "REPLACE_ME",
					"name": "Meshy account"
				}
			}
		},
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--3",
			"name": "Finished?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2,
			"position": [
				720,
				0
			],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict"
					},
					"conditions": [
						{
							"id": "terminal",
							"leftValue": "={{ ['SUCCEEDED', 'FAILED', 'CANCELED'].includes($json.status) }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--4",
			"name": "Wait 5 Seconds",
			"type": "n8n-nodes-base.wait",
			"typeVersion": 1.1,
			"position": [
				720,
				200
			],
			"parameters": {
				"amount": 5
			}
		},
		{
			"id": "meshy-run-task-with-stock-polling-loop-sub-workflow--5",
			"name": "Download File",
			"type": "n8n-nodes-meshy.meshy",
			"typeVersion": 1,
			"position": [
				960,
				0
			],
			"parameters": {
				"resource": "task",
				"taskType": "={{ $('When Called').item.json.taskType }}",
				"operation": "download",
				"downloadSource": "item",
				"format": "={{ $('When Called').item.json.format || 'glb' }}",
				"binaryPropertyOutput": "data"
			},
			"credentials": {
				"meshyApi": {
					"id": "REPLACE_ME",
					"name": "Meshy account"
				}
			}
		}
	],
	"connections": {
		"When Called": {
			"main": [
				[
					{
						"node": "Create Task",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Create Task": {
			"main": [
				[
					{
						"node": "Get Task",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Get Task": {
			"main": [
				[
					{
						"node": "Finished?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Finished?": {
			"main": [
				[
					{
						"node": "Download File",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Wait 5 Seconds",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Wait 5 Seconds": {
			"main": [
				[
					{
						"node": "Get Task",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	},
	"pinData": {}
}
